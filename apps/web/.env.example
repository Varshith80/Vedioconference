SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImZmaWxsc3djd3plZmhsb2p0bmtxIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc4MzYwODQ3NCwiZXhwIjoyMDk5MTg0NDc0fQ.KupT4rHaHfgQyNT8AmZSpXkM8qQAomjmhiPOw8UvHg4

# --- Stripe ------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Sprint 3.5 — per-session PAYG Price ID (€35)
STRIPE_PRICE_PAYG=
# Sprint 5 (Slice A) — Pack 10 Price ID (€299)
STRIPE_PRICE_PACK10=
# Sprint 5 (Slice C, pending) — Monthly Support recurring Price ID (€109/mo)
STRIPE_PRICE_SUBSCRIPTION=

# --- Zoom (server-to-server OAuth) ------------------------------------
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_DEFAULT_HOST_USER_ID=
# Sprint 11 — R-3: webhook signature secret. Verified by
# `POST /api/webhooks/zoom/` against the `x-zm-signature`
# HMAC. Distinct from the S2S-OAuth credentials above.
ZOOM_WEBHOOK_SECRET=

# --- Calendly (personal access token) ---------------------------------
CALENDLY_PERSONAL_TOKEN=
CALENDLY_WEBHOOK_SIGNING_KEY=

# --- Resend ------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@example.com

# --- n8n ---------------------------------------------------------------
N8N_BASE_URL=
N8N_API_KEY=
N8N_WEBHOOK_SECRET=
# Outbound enrollment-event webhook URL — the canonical target
# POSTed by Next.js when an enrollment event is created or a
# pack refund is enqueued. Consumed by the
# `enrollment-created.json` n8n workflow which fans out to
# Stripe / Calendly / Zoom / Resend. When unset, the affected
# routes return 503 (refund) or run in mock mode (free-trial).
# Replace the placeholder below with the production webhook
# URL from your n8n instance — never commit a real value.
N8N_ENROLLMENT_WEBHOOK_URL=

# --- Misc --------------------------------------------------------------
LOG_LEVEL=info
SENTRY_DSN=
