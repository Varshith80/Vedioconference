{
  "name": "enrollment-created",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "enrollment-created",
        "responseMode": "responseNode",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [240, 300],
      "name": "Webhook: enrollment-created",
      "webhookId": "enrollment-created-webhook"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "if-hmac",
              "leftValue": "={{ $json.headers['x-webhook-secret'] }}",
              "rightValue": "={{ $env.N8N_WEBHOOK_SECRET }}",
              "operator": {"type": "string", "operation": "equals"}
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [460, 300],
      "name": "Verify webhook secret"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.stripe.com/v1/checkout/sessions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {"name": "Authorization", "value": "Bearer {{ $env.STRIPE_SECRET_KEY }}"},
            {"name": "Content-Type",  "value": "application/x-www-form-urlencoded"}
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {"name": "mode",       "value": "payment"},
            {"name": "currency",   "value": "={{ $json.body.currency.toLowerCase() }}"},
            {"name": "amount",     "value": "={{ $json.body.amount_cents }}"},
            {"name": "success_url","value": "={{ $json.body.success_url }}"},
            {"name": "cancel_url", "value": "={{ $json.body.cancel_url }}"},
            {"name": "client_reference_id",         "value": "={{ $json.body.session_grant_id }}"},
            {"name": "metadata[session_grant_id]",  "value": "={{ $json.body.session_grant_id }}"},
            {"name": "metadata[student_id]",        "value": "={{ $json.body.student_id }}"},
            {"name": "metadata[session_id]",        "value": "={{ $json.body.session_id }}"},
            {"name": "line_items[0][quantity]", "value": "1"},
            {"name": "line_items[0][price_data][currency]",    "value": "={{ $json.body.currency.toLowerCase() }}"},
            {"name": "line_items[0][price_data][unit_amount]", "value": "={{ $json.body.amount_cents }}"},
            {"name": "line_items[0][price_data][product_data][name]", "value": "={{ $json.body.product_name }}"}
          ]
        },
        "options": {
          "timeout": 20000,
          "response": {"response": {"responseFormat": "json"}}
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 300],
      "name": "Create Stripe Checkout Session"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.NEXT_PUBLIC_SITE_URL }}/api/webhooks/n8n",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {"name": "Content-Type",     "value": "application/json"},
            {"name": "x-webhook-secret", "value": "={{ $env.N8N_WEBHOOK_SECRET }}"}
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {"name": "type",                "value": "session_grant_checkout_created"},
            {"name": "session_grant_id",    "value": "={{ $json.body.session_grant_id }}"},
            {"name": "stripe_session_id",   "value": "={{ $node['Create Stripe Checkout Session'].json.id }}"},
            {"name": "checkout_url",        "value": "={{ $node['Create Stripe Checkout Session'].json.url }}"},
            {"name": "amount_cents",        "value": "={{ $node['Create Stripe Checkout Session'].json.amount_total }}"},
            {"name": "currency",            "value": "={{ $node['Create Stripe Checkout Session'].json.currency }}"}
          ]
        },
        "options": {"response": {"response": {"responseFormat": "json"}}}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 300],
      "name": "Notify Next.js: checkout created (session_grant_checkout_created)"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.NEXT_PUBLIC_SITE_URL }}/api/n8n/notify",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {"name": "Content-Type",     "value": "application/json"},
            {"name": "x-webhook-secret", "value": "={{ $env.N8N_WEBHOOK_SECRET }}"}
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {"name": "type",      "value": "email"},
            {"name": "template",  "value": "session_grant_checkout_created"},
            {"name": "to",        "value": "={{ $json.body.student_email }}"},
            {"name": "locale",    "value": "={{ $json.body.locale ?? 'fr' }}"},
            {"name": "props[workflow]",      "value": "enrollment-created"},
            {"name": "props[studentName]",   "value": "={{ $json.body.student_name }}"},
            {"name": "props[productName]",   "value": "={{ $json.body.product_name }}"}
          ]
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1120, 300],
      "name": "Send checkout-started email (Next.js renderer)"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"checkout_url\": \"{{ $node['Create Stripe Checkout Session'].json.url }}\",\n  \"stripe_session_id\": \"{{ $node['Create Stripe Checkout Session'].json.id }}\"\n}"
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1340, 300],
      "name": "Respond to Next.js"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.NEXT_PUBLIC_SITE_URL }}/api/webhooks/n8n",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {"name": "Content-Type",     "value": "application/json"},
            {"name": "x-webhook-secret", "value": "={{ $env.N8N_WEBHOOK_SECRET }}"}
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {"name": "type",          "value": "workflow_failed"},
            {"name": "workflow",      "value": "enrollment-created"},
            {"name": "error",         "value": "={{ $json.error.message }}"},
            {"name": "original_event","value": "={{ $('Webhook: enrollment-created').first().json }}"}
          ]
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 520],
      "name": "Dead-letter on Stripe error"
    }
  ],
  "connections": {
    "Webhook: enrollment-created": {
