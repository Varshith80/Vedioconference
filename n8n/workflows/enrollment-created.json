  "tags": [{"name": "phase-3"}, {"name": "sprint-10"}],
  "meta": {
    "description": "Sprint 10 — I-1: Next.js checkout route calls this webhook with session_grant_id. The workflow creates the Stripe Checkout Session (metadata session_grant_id, session_id, student_id), POSTs session_grant_checkout_created to the n8n webhook (so the session_grants.stripe_session_id is persisted), POSTs the checkout-started email to /api/n8n/notify, and returns the checkout URL to Next.js. Documented in n8n/docs/WORKFLOWS.md §2.1."
  }
