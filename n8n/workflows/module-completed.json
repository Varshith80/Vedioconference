{
  "name": "module-completed",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "module-completed",
        "responseMode": "responseNode",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [240, 300],
      "name": "Webhook: session-completed",
      "webhookId": "module-completed-webhook"
    },
    {
      "parameters": {
        "conditions": {
          "options": {"caseSensitive": true, "typeValidation": "strict"},
          "conditions": [
            {
              "id": "if-hmac",
              "leftValue": "={{ $json.headers['x-webhook-secret'] }}",
              "rightValue": "={{ $env.N8N_WEBHOOK_SECRET }}",
              "operator": {"type": "string", "operation": "equals"}
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [460, 300],
      "name": "Verify webhook secret"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.NEXT_PUBLIC_SITE_URL }}/api/webhooks/n8n",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {"name": "Content-Type",     "value": "application/json"},
            {"name": "x-webhook-secret", "value": "={{ $env.N8N_WEBHOOK_SECRET }}"}
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {"name": "type",               "value": "session_completed"},
            {"name": "session_booking_id", "value": "={{ $json.body.session_booking_id }}"},
            {"name": "session_id",         "value": "={{ $json.body.session_id }}"},
            {"name": "session_grant_id",   "value": "={{ $json.body.session_grant_id }}"},
            {"name": "completed_at",       "value": "={{ $json.body.completed_at }}"}
          ]
        },
        "options": {"response": {"response": {"responseFormat": "json"}}}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 300],
      "name": "Persist session_completed (Next.js)"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.NEXT_PUBLIC_SITE_URL }}/api/n8n/notify",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {"name": "Content-Type",     "value": "application/json"},
            {"name": "x-webhook-secret", "value": "={{ $env.N8N_WEBHOOK_SECRET }}"}
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {"name": "type",     "value": "email"},
            {"name": "template", "value": "session_completed"},
            {"name": "to",       "value": "={{ $json.body.student_email }}"},
            {"name": "locale",   "value": "={{ $json.body.locale ?? 'fr' }}"},
            {"name": "props[workflow]",    "value": "module-completed"},
            {"name": "props[studentName]", "value": "={{ $json.body.student_name }}"},
            {"name": "props[sessionTitle]","value": "={{ $json.body.session_title }}"},
            {"name": "props[dashboardUrl]","value": "={{ $env.NEXT_PUBLIC_SITE_URL }}"}
          ]
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 300],
      "name": "Send session-completed email (Next.js renderer)"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"ok\": true\n}"
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1120, 300],
      "name": "Respond OK"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.NEXT_PUBLIC_SITE_URL }}/api/webhooks/n8n",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {"name": "Content-Type",     "value": "application/json"},
            {"name": "x-webhook-secret", "value": "={{ $env.N8N_WEBHOOK_SECRET }}"}
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {"name": "type",          "value": "workflow_failed"},
            {"name": "workflow",      "value": "module-completed"},
            {"name": "error",         "value": "={{ $json.error.message }}"},
            {"name": "original_event","value": "={{ $('Webhook: session-completed').first().json }}"}
          ]
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 520],
      "name": "Dead-letter on error"
    }
  ],
  "connections": {
    "Webhook: session-completed": {
      "main": [[{"node": "Verify webhook secret", "type": "main", "index": 0}]]
    },
    "Verify webhook secret": {
      "main": [
        [{"node": "Persist session_completed (Next.js)", "type": "main", "index": 0}],
        [{"node": "Dead-letter on error",                 "type": "main", "index": 0}]
      ]
    },
    "Persist session_completed (Next.js)": {
      "main": [
        [{"node": "Send session-completed email (Next.js renderer)", "type": "main", "index": 0}],
        [{"node": "Dead-letter on error",                            "type": "main", "index": 0}]
      ]
    },
    "Send session-completed email (Next.js renderer)": {
      "main": [[{"node": "Respond OK", "type": "main", "index": 0}]]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveExecutionProgress": true,
    "saveManualExecutions": true
  },
  "tags": [{"name": "phase-3"}, {"name": "sprint-10"}],
  "meta": {
    "description": "Sprint 10 — I-1: v2 session-completed trigger → POST session_completed to /api/webhooks/n8n (Next.js flips session_bookings.status to 'completed' for the supplied session_booking_id, idempotent on replay) → POST session_completed template to /api/n8n/notify. The v1 `evaluate_completion` cascade is REMOVED: grant-level completion is now derived in Sprint 8 B-19 reporting, not here. Documented in n8n/docs/WORKFLOWS.md §2.3."
  }
}
