{
  "name": "module-reschedule",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "module-reschedule",
        "responseMode": "responseNode",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [240, 300],
      "name": "Webhook: session-reschedule",
      "webhookId": "module-reschedule-webhook"
    },
    {
      "parameters": {
        "conditions": {
          "options": {"caseSensitive": true, "typeValidation": "strict"},
          "conditions": [
            {
              "id": "if-hmac",
              "leftValue": "={{ $json.headers['x-webhook-secret'] }}",
              "rightValue": "={{ $env.N8N_WEBHOOK_SECRET }}",
              "operator": {"type": "string", "operation": "equals"}
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [460, 300],
      "name": "Verify webhook secret"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://zoom.us/oauth/token?grant_type=account_credentials&account_id={{ $env.ZOOM_ACCOUNT_ID }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {"name": "Authorization", "value": "Basic {{ Buffer.from($env.ZOOM_CLIENT_ID + ':' + $env.ZOOM_CLIENT_SECRET).toString('base64') }}"}
          ]
        },
        "options": {"response": {"response": {"responseFormat": "json"}}}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 100],
      "name": "Mint Zoom S2S access token"
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "https://api.zoom.us/v2/meetings/{{ $json.body.zoom_meeting_id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {"name": "Authorization", "value": "Bearer {{ $node['Mint Zoom S2S access token'].json.access_token }}"},
            {"name": "Content-Type",  "value": "application/json"}
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {"name": "start_time", "value": "={{ $json.body.new_scheduled_start }}"},
            {"name": "duration",   "value": "={{ $json.body.new_duration_min }}"},
            {"name": "timezone",   "value": "={{ $json.body.timezone }}"}
          ]
        },
        "options": {"timeout": 15000, "response": {"response": {"responseFormat": "json"}}}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 100],
      "name": "Update Zoom meeting"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.NEXT_PUBLIC_SITE_URL }}/api/webhooks/n8n",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {"name": "Content-Type",     "value": "application/json"},
            {"name": "x-webhook-secret", "value": "={{ $env.N8N_WEBHOOK_SECRET }}"}
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {"name": "type",                 "value": "session_booking_rescheduled"},
            {"name": "session_booking_id",   "value": "={{ $json.body.session_booking_id }}"},
            {"name": "new_scheduled_start",  "value": "={{ $json.body.new_scheduled_start }}"},
            {"name": "new_scheduled_end",    "value": "={{ $json.body.new_scheduled_end }}"}
          ]
        },
        "options": {"response": {"response": {"responseFormat": "json"}}}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1120, 100],
      "name": "Persist reschedule (Next.js: session_booking_rescheduled)"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.NEXT_PUBLIC_SITE_URL }}/api/n8n/notify",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {"name": "Content-Type",     "value": "application/json"},
            {"name": "x-webhook-secret", "value": "={{ $env.N8N_WEBHOOK_SECRET }}"}
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {"name": "type",     "value": "email"},
            {"name": "template", "value": "session_booking_rescheduled"},
            {"name": "to",       "value": "={{ $json.body.student_email }}"},
            {"name": "locale",   "value": "={{ $json.body.locale ?? 'fr' }}"},
            {"name": "workflow",       "value": "module-reschedule"},
            {"name": "props[studentName]",     "value": "={{ $json.body.student_name }}"},
            {"name": "props[sessionTitle]",    "value": "={{ $json.body.session_title }}"},
            {"name": "props[scheduledStartIso]","value": "={{ $json.body.new_scheduled_start }}"},
            {"name": "props[joinUrl]",         "value": "={{ $json.body.join_url }}"},
            {"name": "props[dashboardUrl]",    "value": "={{ $env.NEXT_PUBLIC_SITE_URL }}"}
          ]
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1340, 100],
      "name": "Send student reschedule email (Next.js renderer)"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"ok\": true\n}"
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1560, 100],
      "name": "Respond OK"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.NEXT_PUBLIC_SITE_URL }}/api/webhooks/n8n",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {"name": "Content-Type",     "value": "application/json"},
            {"name": "x-webhook-secret", "value": "={{ $env.N8N_WEBHOOK_SECRET }}"}
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {"name": "type",          "value": "workflow_failed"},
            {"name": "workflow",      "value": "module-reschedule"},
            {"name": "error",         "value": "={{ $json.error.message }}"},
            {"name": "original_event","value": "={{ $('Webhook: session-reschedule').first().json }}"}
          ]
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 520],
      "name": "Dead-letter on Zoom error"
    }
  ],
  "connections": {
    "Webhook: session-reschedule": {
      "main": [[{"node": "Verify webhook secret", "type": "main", "index": 0}]]
    },
    "Verify webhook secret": {
      "main": [
        [{"node": "Mint Zoom S2S access token", "type": "main", "index": 0}],
        [{"node": "Dead-letter on Zoom error",  "type": "main", "index": 0}]
      ]
    },
    "Mint Zoom S2S access token": {
      "main": [
        [{"node": "Update Zoom meeting",        "type": "main", "index": 0}],
        [{"node": "Dead-letter on Zoom error",  "type": "main", "index": 0}]
      ]
    },
    "Update Zoom meeting": {
      "main": [
        [{"node": "Persist reschedule (Next.js: session_booking_rescheduled)", "type": "main", "index": 0}],
        [{"node": "Dead-letter on Zoom error",                                  "type": "main", "index": 0}]
      ]
    },
    "Persist reschedule (Next.js: session_booking_rescheduled)": {
      "main": [
        [{"node": "Send student reschedule email (Next.js renderer)", "type": "main", "index": 0}],
        [{"node": "Dead-letter on Zoom error",                        "type": "main", "index": 0}]
      ]
    },
    "Send student reschedule email (Next.js renderer)": {
      "main": [[{"node": "Respond OK", "type": "main", "index": 0}]]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveExecutionProgress": true,
    "saveManualExecutions": true
  },
  "tags": [{"name": "phase-3"}, {"name": "sprint-10"}],
  "meta": {
    "description": "Sprint 10 — I-1: v2 session-booking reschedule (driven by Calendly invitee.updated) → mint Zoom S2S token → PATCH Zoom meeting with the new scheduled_start/duration/timezone → POST session_booking_rescheduled to /api/webhooks/n8n (Next.js flips session_bookings.scheduled_start + scheduled_end + status='confirmed') → send student reschedule email via /api/n8n/notify. The v1 input fields new_start_time / new_duration_min are renamed to new_scheduled_start / new_scheduled_end / new_duration_min to match the v2 schema. Documented in n8n/docs/WORKFLOWS.md §2.5."
  }
}
