  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveExecutionProgress": true,
    "saveManualExecutions": true
  },
  "tags": [{"name": "phase-3"}, {"name": "sprint-10"}],
  "meta": {
    "description": "Sprint 10 — I-1: Catch-all dead-letter / admin-digest workflow. Triggered by any other workflow's error branch to send an admin notification. Asks Next.js to render the chosen admin_* template (default: admin_dead_letter) and send via Resend. The recipient is HARD-CODED server-side in /api/n8n/notify (ADMIN_NOTIFY_EMAIL constant in lib/constants) — the workflow does NOT read an env var and does NOT accept a `to` field in the body, eliminating the v1 attack class where a forged to= leaks a digest. Documented in n8n/docs/WORKFLOWS.md §2.8."
  }
}
