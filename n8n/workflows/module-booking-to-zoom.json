{
  "name": "module-booking-to-zoom",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "module-booking-to-zoom",
        "responseMode": "responseNode",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [240, 300],
      "name": "Webhook: module-booking-to-zoom",
      "webhookId": "module-booking-to-zoom-webhook"
    },
    {
      "parameters": {
        "conditions": {
          "options": {"caseSensitive": true, "typeValidation": "strict"},
          "conditions": [
            {
              "id": "if-hmac",
              "leftValue": "={{ $json.headers['x-webhook-secret'] }}",
              "rightValue": "={{ $env.N8N_WEBHOOK_SECRET }}",
              "operator": {"type": "string", "operation": "equals"}
            },
            {
              "id": "if-event-type",
              "leftValue": "={{ $json.body.type }}",
              "rightValue": "invitee.created",
              "operator": {"type": "string", "operation": "equals"}
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [460, 300],
      "name": "Verify secret + event type"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.NEXT_PUBLIC_SITE_URL }}/api/enrollments/by-calendly-invitee",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {"name": "Content-Type",     "value": "application/json"},
            {"name": "x-webhook-secret", "value": "={{ $env.N8N_WEBHOOK_SECRET }}"}
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {"name": "calendly_invitee_uri", "value": "={{ $json.body.payload.uri }}"},
            {"name": "calendly_event_uri",   "value": "={{ $json.body.payload.event }}"}
          ]
        },
        "options": {"response": {"response": {"responseFormat": "json"}}}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 300],
      "name": "Resolve booking context (Next.js)",
      "continueOnFail": true
    },
    {
      "parameters": {
        "conditions": {
          "options": {"caseSensitive": true, "typeValidation": "strict"},
          "conditions": [
            {
              "id": "if-resolved",
              "leftValue": "={{ $json.ok }}",
              "rightValue": true,
              "operator": {"type": "boolean", "operation": "equals"}
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [900, 300],
      "name": "If resolver returned a row"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://zoom.us/oauth/token?grant_type=account_credentials&account_id={{ $env.ZOOM_ACCOUNT_ID }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {"name": "Authorization", "value": "Basic {{ Buffer.from($env.ZOOM_CLIENT_ID + ':' + $env.ZOOM_CLIENT_SECRET).toString('base64') }}"}
          ]
        },
        "options": {"response": {"response": {"responseFormat": "json"}}}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1120, 100],
      "name": "Mint Zoom S2S access token"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.zoom.us/v2/users/{{ $env.ZOOM_DEFAULT_HOST_USER_ID }}/meetings",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {"name": "Authorization", "value": "Bearer {{ $node['Mint Zoom S2S access token'].json.access_token }}"},
            {"name": "Content-Type",  "value": "application/json"}
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {"name": "topic",      "value": "={{ $node['Resolve booking context (Next.js)'].json.data.course_title }} — {{ $node['Resolve booking context (Next.js)'].json.data.session_title }} — {{ $node['Resolve booking context (Next.js)'].json.data.student_name }}"},
            {"name": "type",       "value": "2"},
            {"name": "start_time", "value": "={{ $node['Resolve booking context (Next.js)'].json.data.scheduled_start }}"},
            {"name": "duration",   "value": "={{ $node['Resolve booking context (Next.js)'].json.data.duration_min }}"},
            {"name": "timezone",   "value": "={{ $node['Resolve booking context (Next.js)'].json.data.timezone }}"},
            {"name": "settings[join_before_host]", "value": "false"},
            {"name": "settings[waiting_room]",     "value": "true"},
            {"name": "settings[mute_upon_entry]",  "value": "true"},
            {"name": "settings[audio]",            "value": "voip"},
            {"name": "tracking_fields[field_name][session_grant_id]", "value": "={{ $node['Resolve booking context (Next.js)'].json.data.session_grant_id }}"},
            {"name": "tracking_fields[field_name][session_booking_id]", "value": "={{ $node['Resolve booking context (Next.js)'].json.data.session_booking_id }}"}
          ]
        },
        "options": {"timeout": 20000, "response": {"response": {"responseFormat": "json"}}}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1340, 100],
      "name": "Create Zoom meeting"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.NEXT_PUBLIC_SITE_URL }}/api/webhooks/n8n",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {"name": "Content-Type",     "value": "application/json"},
            {"name": "x-webhook-secret", "value": "={{ $env.N8N_WEBHOOK_SECRET }}"}
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {"name": "type",                "value": "meeting_created"},
            {"name": "session_booking_id",  "value": "={{ $node['Resolve booking context (Next.js)'].json.data.session_booking_id }}"},
            {"name": "meeting_id",          "value": "={{ $node['Create Zoom meeting'].json.id }}"},
            {"name": "join_url",            "value": "={{ $node['Create Zoom meeting'].json.join_url }}"},
            {"name": "start_url",           "value": "={{ $node['Create Zoom meeting'].json.start_url }}"},
            {"name": "passcode",            "value": "={{ $node['Create Zoom meeting'].json.password }}"},
            {"name": "host_url",            "value": "={{ $node['Create Zoom meeting'].json.start_url }}"}
          ]
        },
        "options": {"response": {"response": {"responseFormat": "json"}}}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1560, 100],
      "name": "Persist meeting_link (Next.js)"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.NEXT_PUBLIC_SITE_URL }}/api/n8n/notify",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {"name": "Content-Type",     "value": "application/json"},
            {"name": "x-webhook-secret", "value": "={{ $env.N8N_WEBHOOK_SECRET }}"}
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {"name": "type",      "value": "email"},
            {"name": "template",  "value": "session_booking_confirmed"},
            {"name": "to",        "value": "={{ $node['Resolve booking context (Next.js)'].json.data.student_email }}"},
            {"name": "locale",    "value": "fr"},
            {"name": "props[workflow]",         "value": "module-booking-to-zoom"},
            {"name": "props[studentName]",      "value": "={{ $node['Resolve booking context (Next.js)'].json.data.student_name }}"},
            {"name": "props[sessionTitle]",     "value": "={{ $node['Resolve booking context (Next.js)'].json.data.session_title }}"},
            {"name": "props[scheduledStartIso]","value": "={{ $node['Resolve booking context (Next.js)'].json.data.scheduled_start }}"},
            {"name": "props[joinUrl]",          "value": "={{ $node['Create Zoom meeting'].json.join_url }}"},
            {"name": "props[dashboardUrl]",     "value": "={{ $env.NEXT_PUBLIC_SITE_URL }}"}
          ]
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1780, 100],
      "name": "Send student confirmation email (Next.js renderer)"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.NEXT_PUBLIC_SITE_URL }}/api/n8n/notify",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {"name": "Content-Type",     "value": "application/json"},
            {"name": "x-webhook-secret", "value": "={{ $env.N8N_WEBHOOK_SECRET }}"}
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {"name": "type",      "value": "email_tutor"},
            {"name": "to",        "value": "={{ $node['Resolve booking context (Next.js)'].json.data.tutor_email }}"},
            {"name": "subject",   "value": "Nouvelle session réservée"},
            {"name": "body",      "value": "Bonjour {{ $node['Resolve booking context (Next.js)'].json.data.tutor_name }},\n\nUne nouvelle session a été réservée.\n\nÉlève : {{ $node['Resolve booking context (Next.js)'].json.data.student_name }}\nCours : {{ $node['Resolve booking context (Next.js)'].json.data.course_title }}\nSession : {{ $node['Resolve booking context (Next.js)'].json.data.session_title }}\nDate : {{ $node['Resolve booking context (Next.js)'].json.data.scheduled_start }}\n\nLien hôte : {{ $node['Create Zoom meeting'].json.start_url }}"},
            {"name": "session_booking_id", "value": "={{ $node['Resolve booking context (Next.js)'].json.data.session_booking_id }}"}
          ]
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1780, 300],
      "name": "Send tutor notification (Next.js renderer)"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"ok\": true,\n  \"zoom_meeting_id\": \"{{ $node['Create Zoom meeting'].json.id }}\"\n}"
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [2000, 200],
      "name": "Respond OK"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.NEXT_PUBLIC_SITE_URL }}/api/webhooks/n8n",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {"name": "Content-Type",     "value": "application/json"},
            {"name": "x-webhook-secret", "value": "={{ $env.N8N_WEBHOOK_SECRET }}"}
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {"name": "type",          "value": "workflow_failed"},
            {"name": "workflow",      "value": "module-booking-to-zoom"},
            {"name": "error",         "value": "={{ $json.error.message }}"},
            {"name": "original_event","value": "={{ $('Webhook: module-booking-to-zoom').first().json }}"}
          ]
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 520],
      "name": "Dead-letter on Zoom error"
    }
  ],
